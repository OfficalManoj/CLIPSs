{
  "about": "Editor suite step KF: captions in the editor's presets (Impact; Block, Large), their fonts staged into fonts/ beside them and burned with fontsdir=fonts, by the one-encode cut and by the editor's pass.",
  "cpu": {
    "commands": [
      {
        "step": "the one-encode cut, landscape",
        "argv": [
          "ffmpeg",
          "-y",
          "-hwaccel",
          "auto",
          "-ss",
          "10.00",
          "-i",
          "<SRC>",
          "-t",
          "10.40",
          "-vsync",
          "cfr",
          "-af",
          "aresample=async=1,loudnorm=I=-14:TP=-1.5:LRA=11",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "-vf",
          "subtitles=clip.ass:fontsdir=fonts",
          "<OUT>"
        ],
        "via": "run",
        "cwd": "<TMP>",
        "ass": {
          "clip.ass": [
            "[Script Info]",
            "ScriptType: v4.00+",
            "PlayResX: 1920",
            "PlayResY: 1080",
            "WrapStyle: 0",
            "",
            "[V4+ Styles]",
            "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
            "Style: Default,Anton,94,&H00FFFFFF,&H00FFFFFF,&H00000000,&H69000000,0,0,0,0,100,100,0,0,1,5.4,0,5,60,60,0,1",
            "",
            "[Events]",
            "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
            "Dialogue: 0,0:00:00.02,0:00:00.55,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}so this is",
            "Dialogue: 0,0:00:00.58,0:00:01.30,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}the part where",
            "Dialogue: 0,0:00:01.33,0:00:02.05,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}it all goes",
            "Dialogue: 0,0:00:02.10,0:00:03.58,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}wrong watch the",
            "Dialogue: 0,0:00:03.62,0:00:05.05,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}left side, right",
            "Dialogue: 0,0:00:05.10,0:00:07.02,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}there. no way",
            "Dialogue: 0,0:00:07.10,0:00:08.35,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}that just happened!",
            "Dialogue: 0,0:00:08.92,0:00:09.70,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}chat did you",
            "Dialogue: 0,0:00:09.75,0:00:09.98,Default,,0,0,0,,{\\an5\\pos(960,918)\\xshad2.7\\yshad3.78}see"
          ]
        }
      },
      {
        "step": "the editor's pass, with cuts",
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/edited.source.mp4",
          "-filter_complex",
          "[0:v]trim=start=0.000:end=3.200,setpts=PTS-STARTPTS[v0];[0:a]atrim=start=0.000:end=3.200,asetpts=PTS-STARTPTS[a0];[0:v]trim=start=4.600:end=10.000,setpts=PTS-STARTPTS[v1];[0:a]atrim=start=4.600:end=10.000,asetpts=PTS-STARTPTS[a1];[v0][a0][v1][a1]concat=n=2:v=1:a=1[vcut][acut];[acut]loudnorm=I=-14:TP=-1.5:LRA=11,aresample=async=1[aout];[vcut]subtitles=edited.ass:fontsdir=fonts[vout]",
          "-map",
          "[vout]",
          "-map",
          "[aout]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/edited.mp4"
        ],
        "via": "run",
        "cwd": "<TMP>",
        "ass": {
          "edited.ass": [
            "[Script Info]",
            "ScriptType: v4.00+",
            "PlayResX: 1920",
            "PlayResY: 1080",
            "WrapStyle: 0",
            "",
            "[V4+ Styles]",
            "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
            "Style: Default,Archivo Black,95,&H00111111,&H00111111,&H004AE1FF,&H00000000,0,0,0,0,100,100,0,0,3,19.44,0,5,60,60,0,1",
            "",
            "[Events]",
            "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
            "Dialogue: 0,0:00:00.02,0:00:00.55,Default,,0,0,0,,{\\an5\\pos(960,918)}so this is",
            "Dialogue: 0,0:00:00.58,0:00:01.30,Default,,0,0,0,,{\\an5\\pos(960,918)}the part where",
            "Dialogue: 0,0:00:01.33,0:00:02.05,Default,,0,0,0,,{\\an5\\pos(960,918)}it all goes",
            "Dialogue: 0,0:00:02.10,0:00:03.58,Default,,0,0,0,,{\\an5\\pos(960,918)}wrong watch the",
            "Dialogue: 0,0:00:03.62,0:00:05.05,Default,,0,0,0,,{\\an5\\pos(960,918)}left side, right",
            "Dialogue: 0,0:00:05.10,0:00:07.02,Default,,0,0,0,,{\\an5\\pos(960,918)}there. no way",
            "Dialogue: 0,0:00:07.10,0:00:08.35,Default,,0,0,0,,{\\an5\\pos(960,918)}that just happened!",
            "Dialogue: 0,0:00:08.92,0:00:09.70,Default,,0,0,0,,{\\an5\\pos(960,918)}chat did you",
            "Dialogue: 0,0:00:09.75,0:00:09.98,Default,,0,0,0,,{\\an5\\pos(960,918)}see"
          ]
        }
      }
    ],
