{
  "about": "The tracker's facecam layout: the webcam band over the game, captions burned.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clip.source.mp4",
          "-filter_complex",
          "[0:v]crop=498:410:0:669,scale=1080:672:force_original_aspect_ratio=increase:flags=lanczos,crop=1080:672,setsar=1[cam];[0:v]crop=934:1080:493:0,scale=1080:1248:flags=lanczos,setsar=1[game];[cam][game]vstack=inputs=2[v];[v]subtitles=clip.ass:fontsdir=fonts[v]",
          "-map",
          "[v]",
          "-map",
          "0:a:0?",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-af",
          "aresample=async=1,loudnorm=I=-14:TP=-1.5:LRA=11",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "-shortest",
          "<OUT>"
        ],
        "via": "run",
        "cwd": "<TMP>",
        "ass": {
          "clip.ass": [
            "[Script Info]",
            "ScriptType: v4.00+",
            "PlayResX: 1080",
            "PlayResY: 1920",
            "WrapStyle: 0",
            "",
            "[V4+ Styles]",
            "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
            "Style: Default,Montserrat Black,150,&H00FFFFFF,&H00FFFFFF,&H00000000,&H69000000,0,0,0,0,100,100,0,0,1,11.52,0,5,208,208,0,1",
            "",
            "[Events]",
            "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
            "Dialogue: 0,0:00:00.02,0:00:00.55,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}so this is",
            "Dialogue: 0,0:00:00.58,0:00:01.02,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}the part",
            "Dialogue: 0,0:00:01.08,0:00:01.70,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}where it all",
            "Dialogue: 0,0:00:01.76,0:00:02.62,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}goes wrong",
            "Dialogue: 0,0:00:03.12,0:00:03.58,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}watch the",
            "Dialogue: 0,0:00:03.62,0:00:04.40,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}left side,",
            "Dialogue: 0,0:00:04.80,0:00:05.62,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}right there.",
            "Dialogue: 0,0:00:06.40,0:00:07.32,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}no way that",
            "Dialogue: 0,0:00:07.36,0:00:07.64,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}just",
            "Dialogue: 0,0:00:07.70,0:00:08.35,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}happened!",
            "Dialogue: 0,0:00:08.92,0:00:09.70,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}chat did you",
            "Dialogue: 0,0:00:09.75,0:00:09.98,Default,,0,0,0,,{\\an5\\pos(540,1422)\\xshad4.8\\yshad6.72}see"
          ]
        }
      }
    ],
    "files": [
      "clip.ass",
      "clip.mp4",
      "clip.source.mp4",
      "fonts/Montserrat-Black.ttf"
    ]
  },
